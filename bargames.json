{
  "id": "music",
  "name": "Music Requests",
  "kind": "app",
  "version": "0.1.3",
  "image": "ghcr.io/thezigpc/venuebox-music:0.1.3",
  "port": 3009,
  "sdk": {
    "version": "0.14.0",
    "level": 2
  },
  "routes": {
    "player": "/",
    "table": "/tv",
    "host": "/host",
    "admin": "/admin"
  },
  "routing": {
    "basePath": true
  },
  "health": "/health",
  "events": [
    "x-music-requested",
    "x-music-approved",
    "x-music-rejected",
    "x-music-now-playing",
    "x-music-skipped",
    "x-music-requests-open",
    "x-music-requests-closed"
  ],
  "commands": [],
  "brandable": [
    "displayName",
    "accent"
  ],
  "audio": {
    "play": true
  },
  "resources": {
    "memory": "384m",
    "cpus": 1
  },
  "network": {
    "internet": true
  },
  "env": {
    "DATA_DIR": "/data"
  }
}
